# Copy this file to .env for local development.
# In Azure, set these as App Service "Application settings" instead of using a .env file.

PORT=8080
NODE_ENV=development

# Shared password used to sign in to the app (choose something long and random for production)
APP_PASSWORD=change-this-password

# Random string used to sign the session cookie (generate with: openssl rand -hex 32)
SESSION_SECRET=change-this-to-a-long-random-string

# Azure Storage Account connection string.
# For local development, run the Azurite emulator (npm run storage:emulator) and use:
#   UseDevelopmentStorage=true
# For production, copy the connection string from Azure Portal -> Storage Account -> Access keys.
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# Names of the Azure Tables used to store data (all created automatically on startup)
AZURE_TABLE_NAME=Tasks
AZURE_LABELS_TABLE_NAME=Labels
AZURE_CREDENTIALS_TABLE_NAME=Credentials

# Passkey (WebAuthn) settings. For local development, localhost is treated as a secure
# context automatically, so these defaults work without HTTPS.
# In production, set these to your real domain, e.g.:
#   WEBAUTHN_RP_ID=tasks.seyedbasim.net
#   WEBAUTHN_ORIGIN=https://tasks.seyedbasim.net
WEBAUTHN_RP_NAME=Basim's Tasks
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8080
